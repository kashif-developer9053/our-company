# Copy to backend/.env on the SERVER and fill in real values.
# This file is committed; backend/.env is gitignored and never committed.
#
# IMPORTANT: wrap any value containing # in double quotes. An unquoted #
# starts a comment and silently truncates the value.

# MongoDB Atlas connection string.
MONGO_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0"

# Secret used to encrypt stored API keys and email passwords.
# MUST match the one already in use, or previously saved keys cannot be decrypted.
ENCRYPTION_SECRET="replace-with-a-long-random-string"

# Refuse to start on an empty in-memory DB if Atlas is unreachable.
# Prevents fake seed data and a bogus "create admin" screen from appearing.
REQUIRE_MONGO=1
